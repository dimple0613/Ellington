# ── Database ─────────────────────────────────────────────────────────────
# Local Postgres during development.
# On Neon (production) use the HYPERDRIVE POOLED connection string:
#   postgresql://<user>:<pass>@ep-...pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# and the UNPOOLED equivalent for migrations/scripts:
#   postgresql://<user>:<pass>@ep-....us-east-1.aws.neon.tech/neondb?sslmode=require
# (see lib/db.ts — the app dials the pooled URL; scripts use the unpooled one)
DATABASE_URL=postgresql://postgres@localhost:5432/developer_inventory

# ── Auth ─────────────────────────────────────────────────────────────────
# REQUIRED in production. Login/session handling fails closed if unset there
# (dev builds fall back to a hard-coded secret).
JWT_SECRET=change-me-in-production

# ── Initial admin (first install / seed only) ─────────────────────────────
# Used ONLY during the initial seed; auth always reads the database afterwards
# (Profile page updates the live credentials). Change these before seeding.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me

# ── Password reset e-mail (Nodemailer / SMTP) ─────────────────────────────
# Optional. When unset, reset links are printed to the server console only in
# development (never to logs in production).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASS=